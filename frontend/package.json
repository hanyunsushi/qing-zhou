{
  "name": "qingzhou-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "build:branched-menu": "node scripts/build-branched-menu.mjs",
    "prebuild": "npm run build:branched-menu",
    "build:microfrontend": "npm run typecheck && npm run build:branched-menu && QZ_MICROFRONTEND=1 vite build --config vite.config.ts && node scripts/verify-microfrontend.mjs"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/vue": "^1.0.8",
    "@vicons/ionicons5": "^0.12.0",
    "echarts": "^5.6.0",
    "framer-motion": "14.3.0",
    "lucide-react": "0.577.0",
    "motion": "14.3.0",
    "naive-ui": "^2.40.0",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-sfc": "3.5.44",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
